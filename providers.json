{
  "_comment": "免鉴权免费大模型来源。freeRule 决定哪些模型算免费；staticModels 是拉不到 /models 时的兜底。",
  "providers": [
    {
      "id": "kilo",
      "label": "Kilo Code",
      "base": "https://api.kilo.ai/api/gateway",
      "modelsPath": "/models",
      "freeRule": { "type": "suffix", "value": ":free" },
      "extraFree": ["kilo-auto/free", "reflection/beam-free", "openrouter/free"],
      "rate": "200 req/h/IP",
      "enabled": true,
      "staticModels": [
        "kilo-auto/free",
        "reflection/beam-free",
        "recursive/flint-v1.0:free",
        "nvidia/nemotron-3.5-super-vl:free",
        "nvidia/nemotron-3.5-lightning:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "poolside/laguna-s-2.1:free",
        "poolside/laguna-xs-2.1:free",
        "cohere/north-mini-code:free",
        "dots-studio/dots-3-note-preview:free",
        "xingchen-agi/xing4.0-29b-a4b:free",
        "liquid/lfm-2.5-2.6b:free",
        "openrouter/free"
      ]
    },
    {
      "id": "pollinations",
      "label": "Pollinations",
      "base": "https://text.pollinations.ai/openai",
      "modelsPath": "/models",
      "freeRule": { "type": "field", "field": "tier", "value": "anonymous" },
      "extraFree": ["openai-fast"],
      "rate": "4 req/min",
      "enabled": true,
      "staticModels": ["openai-fast"]
    },
    {
      "id": "blockrun",
      "label": "BlockRun",
      "base": "https://blockrun.ai/api/v1",
      "modelsPath": "/models",
      "discover": false,
      "freeRule": { "type": "prefix", "value": "nvidia/" },
      "extraFree": [],
      "rate": "IP 限流（免费容量常满）",
      "enabled": true,
      "staticModels": [
        "nvidia/gpt-oss-120b",
        "nvidia/deepseek-v4-flash",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
        "nvidia/step-3.7-flash",
        "nvidia/mistral-nemotron"
      ]
    },
    {
      "id": "ovh",
      "label": "OVHcloud AI Endpoints",
      "base": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "modelsPath": "/models",
      "discover": false,
      "freeRule": { "type": "all" },
      "extraFree": [],
      "rate": "2 req/min/IP/模型（匿名层，欧盟节点）",
      "enabled": true,
      "comment": "匿名层无需注册和 key。只列对话模型——/models 里的 embedding/TTS/ASR/内容安全分类器一律不收。带 tools 元数据使 Qwen 大模型可进 auto 池。",
      "staticModels": [
        { "id": "Qwen3.8-27B", "context_length": 262144, "supported_parameters": ["tools"] },
        { "id": "Qwen3.6-27B", "context_length": 262144, "supported_parameters": ["tools"] },
        { "id": "Qwen3.5-397B-A17B", "context_length": 262144, "supported_parameters": ["tools"] },
        { "id": "Qwen3.5-9B", "context_length": 262144, "supported_parameters": ["tools"] },
        { "id": "gpt-oss-120b", "context_length": 131072, "supported_parameters": ["tools"] },
        { "id": "Meta-Llama-3_3-70B-Instruct", "context_length": 131072 },
        { "id": "Mistral-Small-3.2-24B-Instruct-2506", "context_length": 131072 }
      ]
    },
    {
      "id": "pollinations-gen",
      "label": "Pollinations Gen",
      "base": "https://gen.pollinations.ai/v1",
      "modelsPath": "/models",
      "discover": false,
      "freeRule": { "type": "all" },
      "extraFree": [],
      "rate": "匿名额度极小，耗尽后 401",
      "enabled": false,
      "comment": "2026-10-25 实测：匿名调用 gpt-oss-20b 首次成功，随后持续 401 UNAUTHORIZED（要求 key）。匿名层仅偶发可用，/models 的 405 个模型与 paid_only=false 元数据不可信。停用观察，若恢复再启用。",
      "staticModels": [
        { "id": "openai/gpt-oss-20b", "context_length": 131072, "supported_parameters": ["tools"] }
      ]
    },
    {
      "id": "opencode",
      "label": "OpenCode",
      "base": "https://opencode.ai/inference/v1",
      "modelsPath": "/models",
      "freeRule": { "type": "contains", "value": "-free" },
      "extraFree": ["big-pickle", "beam-free", "grok-code"],
      "rate": "按 IP（当前整体 429）",
      "enabled": false,
      "staticModels": []
    }
  ]
}
